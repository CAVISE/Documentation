msgid ""
"<div class=\"cavise-home\">\n"
"  <section class=\"cavise-hero\">\n"
"    <div class=\"cavise-hero__eyebrow\">Connected & Automated Vehicle Integrated Simulation Environment</div>\n"
"    <h1 class=\"cavise-hero__title\">Build, run, and inspect cooperative driving scenarios.</h1>\n"
"    <p class=\"cavise-hero__lead\">\n"
"      CAVISE documentation brings together operational guides for OpenCDA, Artery, SUMO, and CARLA.\n"
"    </p>\n"
"    <div class=\"cavise-chip-row\">\n"
"      <span class=\"cavise-chip\">OpenCDA</span>\n"
"      <span class=\"cavise-chip\">Artery</span>\n"
"      <span class=\"cavise-chip\">SUMO</span>\n"
"      <span class=\"cavise-chip\">CARLA</span>\n"
"    </div>\n"
"    <div class=\"cavise-hero__actions\">\n"
"      <a class=\"cavise-home-link cavise-home-link--primary\" href=\"wiki/install-and-launch.html\">Install and Launch</a>\n"
"    </div>\n"
"  </section>\n"
"\n"
"  <section class=\"cavise-home-grid\">\n"
"    <a class=\"cavise-card\" href=\"wiki/install-and-launch.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Guides</div>\n"
"      <h2 class=\"cavise-card__title\">Install and Launch</h2>\n"
"      <p class=\"cavise-card__text\">Set up the repository, install dependencies, and bring the simulator stack online.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"scenarios/index.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Workflows</div>\n"
"      <h2 class=\"cavise-card__title\">Scenario Creation</h2>\n"
"      <p class=\"cavise-card__text\">Prepare YAML, SUMO assets, Artery configs, and coordinate data for new scenarios.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"wiki/.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Support</div>\n"
"      <h2 class=\"cavise-card__title\">Problems and Solutions</h2>\n"
"      <p class=\"cavise-card__text\">Resolve common CARLA, OpenCDA, and Artery runtime issues from one place.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"wiki/additional-scripts.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Tooling</div>\n"
"      <h2 class=\"cavise-card__title\">Additional Scripts</h2>\n"
"      <p class=\"cavise-card__text\">Use utility scripts and local Artery helper commands collected from the project wiki.</p>\n"
"    </a>\n"
"  </section>\n"
"\n"
"  <section class=\"cavise-section-panel\">\n"
"    <h2>Platform at a glance</h2>\n"
"    <div class=\"cavise-stack-grid\">\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Environment Setup</strong>\n"
"        <span>Repository bootstrap, dependency installation, and launch flow collected in the Wiki section.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Scenario Authoring</strong>\n"
"        <span>YAML configuration, SUMO assets, `.net.xml`, `.poly.xml`, and Artery scenario files.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Operational Support</strong>\n"
"        <span>Problems and Solutions notes, runtime fixes, and additional helper scripts from the migrated wiki.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Documentation Structure</strong>\n"
"        <span>A smaller, consistent tree centered around Wiki and Scenarios instead of stale legacy sections.</span>\n"
"      </div>\n"
"    </div>\n"
"  </section>\n"
"</div>"
msgstr ""
"<div class=\"cavise-home\">\n"
"  <section class=\"cavise-hero\">\n"
"    <div class=\"cavise-hero__eyebrow\">Интегрированная среда моделирования подключенных и автоматизированных транспортных систем</div>\n"
"    <h1 class=\"cavise-hero__title\">Собирайте, запускайте и анализируйте сценарии кооперативного вождения.</h1>\n"
"    <p class=\"cavise-hero__lead\">\n"
"      Документация CAVISE объединяет практические руководства по OpenCDA, Artery, SUMO и CARLA.\n"
"    </p>\n"
"    <div class=\"cavise-chip-row\">\n"
"      <span class=\"cavise-chip\">OpenCDA</span>\n"
"      <span class=\"cavise-chip\">Artery</span>\n"
"      <span class=\"cavise-chip\">SUMO</span>\n"
"      <span class=\"cavise-chip\">CARLA</span>\n"
"    </div>\n"
"    <div class=\"cavise-hero__actions\">\n"
"      <a class=\"cavise-home-link cavise-home-link--primary\" href=\"wiki/install-and-launch.html\">Установка и запуск</a>\n"
"    </div>\n"
"  </section>\n"
"\n"
"  <section class=\"cavise-home-grid\">\n"
"    <a class=\"cavise-card\" href=\"wiki/install-and-launch.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Руководства</div>\n"
"      <h2 class=\"cavise-card__title\">Установка и запуск</h2>\n"
"      <p class=\"cavise-card__text\">Подготовьте репозиторий, установите зависимости и запустите стек симуляции.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"scenarios/index.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Сценарии</div>\n"
"      <h2 class=\"cavise-card__title\">Создание сценария</h2>\n"
"      <p class=\"cavise-card__text\">Подготовьте YAML, ресурсы SUMO, конфигурации Artery и координатные данные для новых сценариев.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"wiki/.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Поддержка</div>\n"
"      <h2 class=\"cavise-card__title\">Проблемы и решения</h2>\n"
"      <p class=\"cavise-card__text\">Соберите типовые проблемы CARLA, OpenCDA и Artery в одном месте и используйте готовые решения.</p>\n"
"    </a>\n"
"    <a class=\"cavise-card\" href=\"wiki/additional-scripts.html\">\n"
"      <div class=\"cavise-card__eyebrow\">Инструменты</div>\n"
"      <h2 class=\"cavise-card__title\">Дополнительные скрипты</h2>\n"
"      <p class=\"cavise-card__text\">Используйте вспомогательные утилиты и локальные команды Artery, собранные из проектной вики.</p>\n"
"    </a>\n"
"  </section>\n"
"\n"
"  <section class=\"cavise-section-panel\">\n"
"    <h2>Платформа в одном взгляде</h2>\n"
"    <div class=\"cavise-stack-grid\">\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Подготовка окружения</strong>\n"
"        <span>Инициализация репозитория, установка зависимостей и сценарий запуска собраны в разделе Wiki.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Разработка сценариев</strong>\n"
"        <span>YAML-конфигурация, ресурсы SUMO, файлы `.net.xml`, `.poly.xml` и сценарии Artery.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Эксплуатационная поддержка</strong>\n"
"        <span>Заметки по проблемам и решениям, исправлениям среды выполнения и дополнительным вспомогательным скриптам из мигрированной вики.</span>\n"
"      </div>\n"
"      <div class=\"cavise-stack-item\">\n"
"        <strong>Структура документации</strong>\n"
"        <span>Компактное и согласованное дерево, сфокусированное на Wiki и Scenarios вместо устаревших legacy-разделов.</span>\n"
"      </div>\n"
"    </div>\n"
"  </section>\n"
"</div>"
